# Copia este archivo como .env y completa los valores entregados por el docente.
# El archivo .env NO se sube al repositorio.

# --- PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_NAME=appdb
DB_USER=
DB_PASSWORD=

# --- MQTT ---
MQTT_BROKER=emqx.coriotlab.co
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors/SU-CODIGO/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# true: la API arranca tambien el consumidor MQTT. false: solo la API.
MQTT_ENABLED=true

# URL de la API para scripts/generar_evidencias.py
API_URL=http://127.0.0.1:8000
